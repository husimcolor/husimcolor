{
  "version": 3,
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/trpc/[...trpc]"
    },
    {
      "src": "/_expo/static/js/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/_expo/static/css/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/_expo/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/index.html",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!_expo/|assets/).*)",
      "dest": "/index.html"
    }
  ]
}
