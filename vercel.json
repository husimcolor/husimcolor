{
  "outputDirectory": "dist",
  "functions": {
    "api/trpc/[...trpc].ts": {
      "maxDuration": 30
    },
    "api/pdf-report.ts": {
      "maxDuration": 30,
      "includeFiles": "server/assets/HusimPdfKorean.ttf"
    },
    "api/zh-cn-pilot-personal-pdf.ts": {
      "maxDuration": 30,
      "includeFiles": "server/assets/NotoSansCJKsc-Regular.otf"
    },
    "api/en-pilot-personal-pdf.ts": {
      "maxDuration": 30,
      "includeFiles": "server/assets/NotoSansCJKsc-Regular.otf"
    },
    "api/couple-pdf-report.ts": {
      "maxDuration": 30,
      "includeFiles": "server/assets/HusimPdfKorean.ttf"
    }
  },
  "rewrites": [
    { "source": "/api/auth/legacy-admin-login", "destination": "/api/trpc/[...trpc]?legacyAdminRoute=legacy-admin-login" },
    { "source": "/api/auth/legacy-admin-session", "destination": "/api/trpc/[...trpc]?legacyAdminRoute=legacy-admin-session" },
    { "source": "/api/auth/legacy-admin-logout", "destination": "/api/trpc/[...trpc]?legacyAdminRoute=legacy-admin-logout" },
    { "source": "/api/trpc/:path*", "destination": "/api/trpc/[...trpc]" },
    { "source": "/api/pdf-report", "destination": "/api/pdf-report" },
    { "source": "/api/zh-cn-pilot-personal-pdf", "destination": "/api/zh-cn-pilot-personal-pdf" },
    { "source": "/api/en-pilot-personal-pdf", "destination": "/api/en-pilot-personal-pdf" },
    { "source": "/api/couple-pdf-report", "destination": "/api/couple-pdf-report" },
    { "source": "/zh-cn-pilot", "destination": "/zh-cn-pilot.html" },
    { "source": "/zh-cn-pilot/colors", "destination": "/zh-cn-pilot-colors.html" },
    { "source": "/zh-cn-pilot/cards", "destination": "/zh-cn-pilot-cards.html" },
    { "source": "/zh-cn-pilot/recovery", "destination": "/zh-cn-pilot-recovery.html" },
    { "source": "/en-pilot", "destination": "/en-pilot.html" },
    { "source": "/en-pilot/colours", "destination": "/en-pilot-colours.html" },
    { "source": "/en-pilot/cards", "destination": "/en-pilot-cards.html" },
    { "source": "/en-pilot/recovery", "destination": "/en-pilot-recovery.html" },
    { "source": "/((?!_expo/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(couple-result|couple-start|couple-card-select|premium-color-select|premium-result|payment)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/_expo/static/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_expo/static/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sample-reports/(.*)\\.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
